{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AZURE_SUBSCRIPTION_ID": "<subscription-id-guid>",
    "WorkspaceId": "<workspace-id-guid>",
    "LOG_ANALYTICS_WORKSPACE_ID": "<workspace-id-guid>",
    "LOG_ANALYTICS_QUERY_TIMEOUT_SECONDS": "30",
    "ALLOW_ORIGINS": "*"
  },
  "Host": {
    "CORS": "*"
  }
}
