{
  "name": "sentinel-detection-pack-ui",
  "private": true,
  "version": "2.0.0",
  "description": "Portfolio UI for a Microsoft Sentinel cloud security detection engineering lab.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync-data && vite build",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-data.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "evidence:screenshots": "node scripts/generate-evidence-screenshots.mjs",
    "evidence:all": "npm run build && npm run evidence:screenshots && npm run test:e2e:built"
  },
  "dependencies": {
    "@kusto/monaco-kusto": "^15.0.1",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.17.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "framer-motion": "^10.17.0",
    "lucide-react": "^0.303.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "reactflow": "^11.10.1",
    "recharts": "^2.10.3",
    "simplex-noise": "^4.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^5.0.10"
  }
}
