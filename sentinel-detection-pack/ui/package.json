{
  "name": "sentinel-detection-pack-ui",
  "private": true,
  "version": "2.0.0",
  "description": "Portfolio UI for a Microsoft Sentinel cloud security detection engineering lab.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync-data && vite build",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-data.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "evidence:screenshots": "node scripts/generate-evidence-screenshots.mjs",
    "evidence:all": "npm run build && npm run evidence:screenshots && npm run test:e2e"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.17.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "framer-motion": "^10.17.0",
    "lucide-react": "^0.303.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "reactflow": "^11.10.1",
    "recharts": "^2.10.3",
    "simplex-noise": "^4.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10"
  }
}
